<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:MS43Logger.AvaloniaApp"
        xmlns:shell="using:MS43Logger.AvaloniaApp.Shell"
        xmlns:views="using:MS43Logger.AvaloniaApp.Views"
        xmlns:controls="using:MS43Logger.AvaloniaApp.Controls"
        xmlns:theme="using:MS43Logger.AvaloniaApp.Theme"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MS43Logger.AvaloniaApp.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="MS43 Tuner"
        Icon="avares://MS43Logger.AvaloniaApp/Assets/ms43-tuner.ico"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="680"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Styles>
        <!-- The maximize button shows the glyph of what it will do: maximize, or restore once maximized. -->
        <Style Selector="controls|StrokeIcon#RestoreGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.maximized controls|StrokeIcon#RestoreGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window.maximized controls|StrokeIcon#MaximizeGlyph">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Ink3 falls under 4.5:1 on the pressed overlay (4.20 Day, 3.79 Night), so the file line's labels rise to Ink2. -->
        <Style Selector="Button#FileMenuButton:pressed TextBlock.meta">
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock#PlateFile.empty">
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <!-- Below 1280 px of header: no wordmark, no XDF line, and the connection pickers merge into one button.
             The window buttons take 146 px of the window's width, so the header compacts below 1426 px of window
             (class "compactheader"); the panes keep the 1280 px step ("compact"). -->
        <Style Selector="Button#ConnectionButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.compactheader TextBlock#Wordmark, Window.compactheader Panel#PlateDetails, Window.compactheader StackPanel#ConnectionPickers, Window.compact TextBlock#ReadoutsLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.compactheader Button#ConnectionButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- The header's room: a tighter margin after the mark, and the words "slow link" step aside
             while the rate and its warning icon stay. -->
        <Style Selector="StackPanel#Brand">
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>
        <Style Selector="Window.compactheader StackPanel#Brand">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="Window.compactheader Panel#SlowLinkWords">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Below 1280 px the tab column narrows, so the screens keep the room they had with the tabs in the header. -->
        <Style Selector="Border#NavRail">
            <Setter Property="Width" Value="120" />
        </Style>
        <Style Selector="Window.compact Border#NavRail">
            <Setter Property="Width" Value="80" />
        </Style>
        <Style Selector="Window.compact ToggleButton.navtab">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Window.compact TextBlock#RateUnit">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <!-- Sizes live in styles, not on the elements, so the compact rules below can change them. -->
        <Style Selector="Button#FileMenuButton">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="TextBlock#PlateFile">
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <Style Selector="Window.compactheader Button#FileMenuButton">
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Window.compactheader TextBlock#PlateFile">
            <Setter Property="MaxWidth" Value="200" />
        </Style>
    </Window.Styles>

    <!-- A maximized window without the system frame reaches past the screen edge by the frame's width; the margin pulls it back. -->
    <Grid Name="RootGrid" RowDefinitions="48,*,28" Margin="{Binding $parent[Window].OffScreenMargin}">
        <!-- Header. It is also the window's title bar: drag it to move, double-click it to maximize or restore.
             The right padding leaves room for the window buttons, which sit above the dialog layer at the end of this grid. -->
        <Border Name="TitleBar" Grid.Row="0" Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                Padding="16,0,146,0" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Name="Brand" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <shell:AppMark Name="AppMark" IsLive="{Binding Live.IsConnected}" Level="{Binding Live.EngineSpeedLevel}" />
                    <TextBlock Name="Wordmark" Classes="title" Text="MS43 Tuner" VerticalAlignment="Center" />
                </StackPanel>

                <!-- The file button gives way when the header is short: first the XDF line steps aside (it is in the
                     tooltip), then the name trims in the middle. The chip and Save keep their size. -->
                <Grid Name="FileBlock" Grid.Column="2" ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Name="FileMenuButton" Classes="quiet" Padding="8,0" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="File" ToolTip.Tip="{Binding Tune.PlateTip}">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Name="OpenBinMenuItem" Header="Open bin…" InputGesture="Ctrl+O" Click="OpenBin_Click" />
                                <MenuItem Name="UseXdfMenuItem" Header="Use another XDF…" Click="UseXdf_Click" />
                                <MenuItem Name="SaveAsMenuItem" Header="Save as…" InputGesture="Ctrl+Shift+S" Click="SaveAs_Click" IsEnabled="{Binding Tune.HasDocument}" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                <TextBlock Name="PlateFile" Text="{Binding Tune.PlateFile}" FontWeight="SemiBold" Foreground="{DynamicResource Ink1Brush}"
                                           TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}" Classes.empty="{Binding !Tune.HasDocument}" />
                                <controls:StrokeIcon Grid.Column="1" Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" Margin="4,0,0,0"
                                                     VerticalAlignment="Center" />
                            </Grid>
                            <Panel Name="PlateDetails">
                                <shell:FactLine Name="PlateFacts" Spacing="6" IsVisible="{Binding Tune.HasDocument}">
                                    <TextBlock Classes="meta" Text="Firmware" />
                                    <TextBlock Classes="mono" Text="{Binding Tune.PlateFirmware}" Foreground="{DynamicResource Ink2Brush}" />
                                    <TextBlock Classes="meta" Text="XDF" />
                                    <TextBlock Classes="label" Text="{Binding Tune.PlateXdf}" MinWidth="64" MaxWidth="220"
                                               TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}" />
                                </shell:FactLine>
                            </Panel>
                        </StackPanel>
                    </Button>
                    <Border Name="SaveStateChip" Grid.Column="1" Margin="12,0,0,0" Classes="chip" IsVisible="{Binding Tune.HasDocument}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:StrokeIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" VerticalAlignment="Center"
                                                 IsVisible="{Binding !Tune.HasUnsavedChanges}" />
                            <controls:StrokeIcon FillData="{StaticResource Mark.Changed}" Width="6" Height="6" VerticalAlignment="Center"
                                                 IsVisible="{Binding Tune.HasUnsavedChanges}" />
                            <TextBlock Name="SaveStateText" Text="{Binding Tune.SaveStateText}" />
                        </StackPanel>
                    </Border>
                    <Button Name="SaveButton" Grid.Column="2" Margin="12,0,0,0" Content="Save" Click="Save_Click" IsVisible="{Binding Tune.HasDocument}"
                            Classes.primary="{Binding SaveIsPrimary}" IsEnabled="{Binding Tune.HasUnsavedChanges}"
                            ToolTip.Tip="{Binding Tune.SaveTip}" ToolTip.ShowOnDisabled="True" />
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Rate, only while connected: "38 samples/s", or "No samples yet". -->
                    <StackPanel Name="RateText" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0"
                                IsVisible="{Binding Live.IsConnected}" ToolTip.Tip="{Binding Live.RateDetail}">
                        <TextBlock Classes="label" Text="No samples yet" IsVisible="{Binding Live.HasNoSamplesYet}" />
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Live.HasNoSamplesYet}">
                            <TextBlock Classes="data13" FontWeight="SemiBold" Foreground="{DynamicResource NowTextBrush}" Text="{Binding Live.RateValue}" VerticalAlignment="Center" />
                            <TextBlock Name="RateUnit" Classes="label" Text="samples/s" VerticalAlignment="Center" />
                            <controls:StrokeIcon Data="{StaticResource Icon.Warn}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14"
                                                 VerticalAlignment="Center" IsVisible="{Binding Live.IsSlowLink}" />
                            <Panel Name="SlowLinkWords" VerticalAlignment="Center">
                                <TextBlock Name="SlowLinkText" Classes="label" Text="slow link" VerticalAlignment="Center" IsVisible="{Binding Live.IsSlowLink}" />
                            </Panel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Name="ConnectionPickers" Orientation="Horizontal" Spacing="8">
                        <ComboBox Name="PortPicker" ItemsSource="{Binding Live.AvailablePorts}" SelectedItem="{Binding Live.SelectedPort}"
                                  MinWidth="112" AutomationProperties.Name="Port">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="label" Text="Port" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                        </ComboBox>
                        <Button Name="RescanButton" Classes="quiet icon" Click="RefreshButton_Click"
                                ToolTip.Tip="Rescan ports" AutomationProperties.Name="Rescan ports">
                            <controls:StrokeIcon Data="{StaticResource Icon.Rescan}" />
                        </Button>
                        <ComboBox Name="DefinitionPicker" ItemsSource="{Binding Live.AdxVariants}" SelectedItem="{Binding Live.SelectedVariant}"
                                  MinWidth="148" AutomationProperties.Name="Definition">
                            <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="label" Text="Definition" VerticalAlignment="Center" />
                                        <TextBlock Classes="mono" Text="{Binding}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="mono" Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Name="ConnectionButton" AutomationProperties.Name="Connection settings" ToolTip.Tip="Port, rescan and definition">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox Name="CompactPortPicker" ItemsSource="{Binding Live.AvailablePorts}" SelectedItem="{Binding Live.SelectedPort}"
                                                  MinWidth="112" AutomationProperties.Name="Port" />
                                        <Button Name="CompactRescanButton" Classes="quiet icon" Click="RefreshButton_Click"
                                                ToolTip.Tip="Rescan ports" AutomationProperties.Name="Rescan ports">
                                            <controls:StrokeIcon Data="{StaticResource Icon.Rescan}" />
                                        </Button>
                                    </StackPanel>
                                    <ComboBox Name="CompactDefinitionPicker" ItemsSource="{Binding Live.AdxVariants}" SelectedItem="{Binding Live.SelectedVariant}"
                                              MinWidth="148" AutomationProperties.Name="Definition">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Classes="mono" Text="{Binding}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Live.SelectedPort}" VerticalAlignment="Center" />
                            <TextBlock Text="·" Foreground="{DynamicResource Ink3Brush}" VerticalAlignment="Center" />
                            <TextBlock Classes="mono" Text="{Binding Live.SelectedVariant}" VerticalAlignment="Center" />
                            <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Name="ConnectButton" Content="{Binding Live.ConnectionButtonText}" Click="ConnectButton_Click" MinWidth="96"
                            Classes.primary="{Binding ConnectIsPrimary}" Classes.quiet="{Binding Live.IsConnected}"
                            IsEnabled="{Binding !Live.IsConnecting}" />
                    <Button Name="SettingsButton" Classes="quiet icon" ToolTip.Tip="Settings (Ctrl ,)" AutomationProperties.Name="Settings" Margin="4,0,0,0"
                            Click="Settings_Click">
                        <controls:StrokeIcon Data="{StaticResource Icon.Gear}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Screens, with the tabs in a column on their left: the header keeps the file, Save and the connection. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Name="NavRail" Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                    Padding="0,8">
                <StackPanel Name="Tabs" Orientation="Vertical">
                    <ToggleButton Name="TabLive" Classes="navtab" Content="Live" IsChecked="{Binding IsLive}" />
                    <ToggleButton Name="TabTune" Classes="navtab" Content="Tune" IsChecked="{Binding IsTune}" />
                    <ToggleButton Name="TabLiveTuning" Classes="navtab" Content="Live tuning" IsChecked="{Binding IsLiveTuning}" />
                    <ToggleButton Name="TabFun" Classes="navtab" Content="Fun" IsChecked="{Binding IsFun}" />
                    <ToggleButton Name="TabCompare" Classes="navtab" Content="Compare" IsChecked="{Binding IsCompare}" />
                    <ToggleButton Name="TabPerformance" Classes="navtab" Content="Performance" IsChecked="{Binding IsPerformance}" />
                </StackPanel>
            </Border>
            <Panel Grid.Column="1">
                <views:LiveView DataContext="{Binding Live}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsLive}" />
                <views:TuneView DataContext="{Binding Tune}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsTune}" />
                <views:LiveTuningView DataContext="{Binding LiveTuning}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsLiveTuning}" />
                <views:FunView DataContext="{Binding Fun}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsFun}" />
                <views:CompareView DataContext="{Binding Compare}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsCompare}" />
                <views:PerformanceView DataContext="{Binding Performance}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsPerformance}" />
            </Panel>
        </Grid>

        <!-- Opening another bin: the open one stays and a 2 px bar runs under the header. -->
        <ProgressBar Name="BusyBar" Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding Tune.ShowsBusyBar}" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,0,8,0">
            <!-- The connection line takes the width left over and trims its end; the whole line is in its tooltip. -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <Panel Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse Name="ConnectionDot" Stroke="{DynamicResource EdgeBrush}" StrokeThickness="1.5" IsVisible="{Binding !Live.IsConnected}" />
                    <Ellipse Fill="{DynamicResource NowBrush}" IsVisible="{Binding Live.IsConnected}" />
                </Panel>
                <TextBlock Name="ConnectionText" Grid.Column="1" Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource Ink2Brush}" VerticalAlignment="Center"
                           FontFeatures="{x:Static theme:Typography.Tabular}" TextTrimming="CharacterEllipsis" />
                <!-- While connected: start or stop the CSV log at once, each start a new file. -->
                <ToggleButton Name="LogButton" Grid.Column="2" Classes="seg small" Content="{Binding Live.LogButtonText}"
                              IsChecked="{Binding Live.EnableCsvLogging}" IsVisible="{Binding Live.IsConnected}"
                              AutomationProperties.Name="CSV log" ToolTip.Tip="{Binding Live.CsvPath}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Name="ReadoutsSeg" Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" IsVisible="{Binding IsLive}">
                    <TextBlock Name="ReadoutsLabel" Classes="label" Text="Readouts" VerticalAlignment="Center" />
                    <Border Classes="seg small" AutomationProperties.Name="Readouts" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Name="ReadoutsTiles" Classes="seg small" Content="Tiles" IsChecked="{Binding IsTiles}" />
                            <ToggleButton Name="ReadoutsDials" Classes="seg small" Content="Dials" IsChecked="{Binding IsDials}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Column="4" Classes="seg small" AutomationProperties.Name="Theme" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- A moon and a sun: the words are the tooltips and what a screen reader says. -->
                        <ToggleButton Name="NightButton" Classes="seg small" IsChecked="{Binding IsNight}" Padding="8,0"
                                      ToolTip.Tip="Night" AutomationProperties.Name="Night">
                            <controls:StrokeIcon Data="{StaticResource Icon.Moon}" Width="14" Height="14" />
                        </ToggleButton>
                        <ToggleButton Name="DayButton" Classes="seg small" IsChecked="{Binding IsDay}" Padding="8,0"
                                      ToolTip.Tip="Day" AutomationProperties.Name="Day">
                            <controls:StrokeIcon Data="{StaticResource Icon.Sun}" Width="14" Height="14" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Last, so a dialog and its scrim cover the header, the screens and the status bar. -->
        <shell:DialogHost Name="Dialogs" Grid.RowSpan="3" />

        <!-- The theme cross-fade: a picture of the old theme over the new one, fading out. Above everything, never hit. -->
        <Image Name="ThemeFade" Grid.RowSpan="3" Stretch="Fill" IsVisible="False" IsHitTestVisible="False" ZIndex="100" />

        <!-- Window buttons, after the dialog layer so the window can still be minimized or closed while a dialog is open. -->
        <StackPanel Name="WindowButtons" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="47">
            <Button Name="MinimizeButton" Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize">
                <controls:StrokeIcon Data="{StaticResource Icon.WindowMinimize}" />
            </Button>
            <Button Name="MaximizeButton" Classes="caption" Click="Maximize_Click" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize">
                <Panel>
                    <controls:StrokeIcon Name="MaximizeGlyph" Data="{StaticResource Icon.WindowMaximize}" />
                    <controls:StrokeIcon Name="RestoreGlyph" Data="{StaticResource Icon.WindowRestore}" />
                </Panel>
            </Button>
            <Button Name="CloseButton" Classes="caption close" Click="Close_Click" ToolTip.Tip="Close" AutomationProperties.Name="Close">
                <controls:StrokeIcon Data="{StaticResource Icon.WindowClose}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
