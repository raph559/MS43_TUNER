<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:MS43Logger.AvaloniaApp"
        xmlns:shell="using:MS43Logger.AvaloniaApp.Shell"
        xmlns:views="using:MS43Logger.AvaloniaApp.Views"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MS43Logger.AvaloniaApp.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="MS43 Tuner"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="680">

    <Grid RowDefinitions="58,*,36">
        <!-- Header: mark, screens, open file, connection -->
        <Border Grid.Row="0" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,22,0">
                    <shell:AppMark IsLive="{Binding Live.IsConnected}" Level="{Binding Live.EngineSpeedLevel}" />
                    <TextBlock Classes="display" Text="MS43 Tuner" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Name="TabLive" Classes="tab" Content="Live" IsChecked="{Binding IsLive}" />
                    <ToggleButton Name="TabTune" Classes="tab" Content="Tune" IsChecked="{Binding IsTune}" />
                </StackPanel>

                <Border Grid.Column="2" Margin="22,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="1"
                        CornerRadius="8" Background="{DynamicResource DialBrush}" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="PlateFile" Text="{Binding Tune.PlateFile}" Margin="12,6" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                        <Border BorderBrush="{DynamicResource BezelBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding Tune.HasDocument}">
                            <TextBlock Text="{Binding Tune.PlateFirmware}" Margin="12,6" Foreground="{DynamicResource OkBrush}" />
                        </Border>
                        <Border BorderBrush="{DynamicResource BezelBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding Tune.HasDocument}">
                            <TextBlock Text="{Binding Tune.PlateXdf}" Margin="12,6" Foreground="{DynamicResource Ink2Brush}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border BorderBrush="{DynamicResource BezelBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding Tune.HasDocument}">
                            <TextBlock Name="PlateDirty" Text="{Binding Tune.DirtyText}" Margin="12,6" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Live.AvailablePorts}" SelectedItem="{Binding Live.SelectedPort}" MinWidth="92" ToolTip.Tip="Serial port" />
                    <Button Classes="ghost" Content="↻" Click="RefreshButton_Click" ToolTip.Tip="Refresh ports" />
                    <ComboBox ItemsSource="{Binding Live.AdxVariants}" SelectedItem="{Binding Live.SelectedVariant}" MinWidth="84" ToolTip.Tip="ADX definition" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="6,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource NeedleBrush}" IsVisible="{Binding Live.IsConnected}" />
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Ink3Brush}" IsVisible="{Binding Live.IsNotConnected}" />
                        <TextBlock Classes="num" Text="{Binding Live.RateText}" Foreground="{DynamicResource Ink2Brush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="primary" Content="{Binding Live.ConnectionButtonText}" Click="ConnectButton_Click" MinWidth="104" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Screens -->
        <Panel Grid.Row="1">
            <views:LiveView DataContext="{Binding Live}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsLive}" />
            <views:TuneView DataContext="{Binding Tune}" IsVisible="{Binding $parent[Window].((local:ShellViewModel)DataContext).IsTune}" />
        </Panel>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Live.StatusText}" Foreground="{DynamicResource Ink3Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Classes="seg" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Name="NightButton" Classes="seg" Content="Night" IsChecked="{Binding IsNight}" />
                        <ToggleButton Name="DayButton" Classes="seg" Content="Day" IsChecked="{Binding IsDay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
