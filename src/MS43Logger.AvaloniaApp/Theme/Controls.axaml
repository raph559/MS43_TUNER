<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base look: graphite panes, 1 px bezels, controls with a 7 px radius; orange only for "now" and keyboard focus. -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource DialBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBlock.num, TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <!-- Orange means "now": only the live cursor's readout uses it. -->
    <Style Selector="TextBlock.readout">
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="TextBlock.readout.live">
        <Setter Property="Foreground" Value="{DynamicResource NeedleBrush}" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bezel2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BezelBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DialBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DialBrush}" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
    </Style>

    <!-- Screen tabs in the header -->
    <Style Selector="ToggleButton.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    <Border Name="Indicator" Height="2" VerticalAlignment="Bottom" Margin="14,0" Background="Transparent" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <Style Selector="ToggleButton.tab:checked">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="ToggleButton.tab:checked /template/ Border#Indicator">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
    </Style>

    <!-- Segmented controls (Physical/Raw, Night/Day, compare views) -->
    <Style Selector="ToggleButton.seg">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="11,3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="Border.seg">
        <Setter Property="BorderBrush" Value="{DynamicResource Bezel2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Chips and plates -->
    <Style Selector="Border.chip">
        <Setter Property="BorderBrush" Value="{DynamicResource Bezel2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,1" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource DialBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bezel2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DialBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource DialBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NeedleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bezel2Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink3Brush}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>

    <!-- Lists in the rail -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource NeedleBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource NeedleBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource NeedleBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource NeedleBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderBrush="{DynamicResource NeedleBrush}" BorderThickness="2" CornerRadius="8" Margin="-3" />
            </FocusAdornerTemplate>
        </Setter>
    </Style>
</Styles>
