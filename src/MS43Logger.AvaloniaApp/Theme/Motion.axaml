<!--
    The motion layer (system 10.3, MOTION 2). App.ApplyMotion adds this file only while Windows' "Animation effects"
    setting is on; without it every state below is reached at once. Each motion answers something the user did and says
    what changed. Live values (gauges, numbers, the map cursor) are never animated: a needle or number in motion would
    show a value the engine never had.

    Timing: 120 ms for hover and press (felt, not watched), 180 to 200 ms for things that appear (screens, dialogs,
    banners), cubic ease-out so motion starts fast and lands softly.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:MS43Logger.AvaloniaApp.Views"
        xmlns:shell="using:MS43Logger.AvaloniaApp.Shell"
        xmlns:controls="using:MS43Logger.AvaloniaApp.Controls">

    <!-- Hover and press: the overlay fades instead of blinking, so moving across a toolbar does not flicker. -->
    <Style Selector="Button /template/ Border#PART_Overlay, ToggleButton /template/ Border#PART_Overlay, ListBoxItem /template/ Border#PART_Overlay">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Fills that change with state (primary buttons darken, Close turns red, a segment fills): same fade. -->
    <Style Selector="Button, ToggleButton.seg">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- A segment pick slides: one raised pill under the segments moves to the new choice (SegmentSlide), and the
         checked segment stops filling itself so the pill shows through. -->
    <Style Selector="Border.seg">
        <Setter Property="controls:SegmentSlide.IsEnabled" Value="True" />
    </Style>
    <Style Selector="Border.seg.sliding ToggleButton.seg">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.seg.sliding ToggleButton.seg:checked">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.seg Border.segpill">
        <Setter Property="Background" Value="{DynamicResource ButtonRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The tab bar grows from its centre: it shows which screen was just picked. -->
    <Style Selector="ToggleButton.navtab /template/ Border#Indicator">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- A screen coming to the front fades in and rises 6 px, so the change of screen reads as one. -->
    <Style Selector="views|LiveView[IsVisible=True], views|TuneView[IsVisible=True], views|CompareView[IsVisible=True], views|PerformanceView[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- A dialog: the scrim fades in and the card grows from 97 %, so it is seen arriving over the screen it covers. -->
    <Style Selector="shell|DialogHost[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="shell|DialogHost[IsVisible=True] > Border.dialog">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Menus, picker lists and tooltips drop 4 px into place as they fade in, from the control that opened them. -->
    <Style Selector="MenuFlyoutPresenter, FlyoutPresenter, ComboBox /template/ Border#PopupBorder, ToolTip">
        <Style.Animations>
            <Animation Duration="0:0:0.12" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-4" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- A banner (a warning, a refused connection) slides down into its place: new information draws the eye once. -->
    <Style Selector="Border.banner[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-6" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- A side list (Tune rail, Compare list, Performance rail) slides closed to its strip and open again (Ctrl B), so it is seen going where it went. -->
    <Style Selector="Border.toggling">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <!-- The theme switch: the moon or sun just picked turns into place as the window cross-fades (MainWindow.FadeTheme). -->
    <Style Selector="ToggleButton#NightButton:checked > controls|StrokeIcon, ToggleButton#DayButton:checked > controls|StrokeIcon">
        <Style.Animations>
            <Animation Duration="0:0:0.36" Easing="CubicEaseOut">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="-90" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Switches: the knob slides to its side, which says which way it went, while the track fills and the knob turns
         colour with it; an instant fill hid the short slide. -->
    <Style Selector="ToggleSwitch">
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Property="Canvas.Left" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch /template/ Border#OuterBorder, ToggleSwitch /template/ Border#SwitchKnobBounds, ToggleSwitch /template/ Ellipse#SwitchKnobOn, ToggleSwitch /template/ Ellipse#SwitchKnobOff">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
