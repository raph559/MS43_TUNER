<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The app's one icon set, drawn on a 16 px grid for a 1.5 px stroke with flat caps and mitre joins.
        StrokeIcon strokes these; the few filled parts (a pinned pin's body, the switch glyph's square, the changed
        triangle) are separate *.Fill geometries. Same paths as the approved mockups.
    -->
    <StreamGeometry x:Key="Icon.Search">M 2.75,7 A 4.25,4.25 0 1 1 11.25,7 A 4.25,4.25 0 1 1 2.75,7 Z M 10.2,10.2 L 14,14</StreamGeometry>
    <StreamGeometry x:Key="Icon.Clear">M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pin">M 4.75,2.25 L 11.25,2.25 M 6.25,2.25 L 6.25,6.75 L 4.25,9.25 L 11.75,9.25 L 9.75,6.75 L 9.75,2.25 M 8,9.25 L 8,14.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.PinFilled">M 4.75,2.25 L 11.25,2.25 M 6.25,2.25 L 6.25,6.75 L 4.25,9.25 L 11.75,9.25 L 9.75,6.75 L 9.75,2.25 Z M 8,9.25 L 8,14.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.PinFilled.Fill">M 6.25,2.25 L 6.25,6.75 L 4.25,9.25 L 11.75,9.25 L 9.75,6.75 L 9.75,2.25 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M 4.5,6.25 L 8,9.75 L 11.5,6.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronRight">M 6.25,4.5 L 9.75,8 L 6.25,11.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Rescan">M 12.75,6.5 A 5,5 0 0 0 3.6,5.2 M 3.25,9.5 A 5,5 0 0 0 12.4,10.8 M 3.25,2.5 L 3.25,5.5 L 6.25,5.5 M 12.75,13.5 L 12.75,10.5 L 9.75,10.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warn">M 8,2 L 14.5,13.5 L 1.5,13.5 Z M 8,6 L 8,10 M 8,11.25 L 8,12.5</StreamGeometry>
    <!-- Enlarge, for the surface plot (its zoom uses Minus and Plus). -->
    <!-- A table in a window of its own: a frame with an arrow leaving its corner. -->
    <StreamGeometry x:Key="Icon.OpenWindow">M 7.25,3.25 L 3.25,3.25 L 3.25,12.75 L 12.75,12.75 L 12.75,8.75 M 9.25,2.75 L 13.25,2.75 L 13.25,6.75 M 13.25,2.75 L 7.75,8.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.Enlarge">M 9.25,2.75 L 13.25,2.75 L 13.25,6.75 M 13.25,2.75 L 9,7 M 6.75,13.25 L 2.75,13.25 L 2.75,9.25 M 2.75,13.25 L 7,9</StreamGeometry>
    <!-- The theme switch: a crescent moon for Night, a sun for Day. -->
    <StreamGeometry x:Key="Icon.Moon">M 12.75,10.25 A 5.25,5.25 0 1 1 5.75,3.25 A 4.25,4.25 0 0 0 12.75,10.25 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Sun">M 5.5,8 A 2.5,2.5 0 1 1 10.5,8 A 2.5,2.5 0 1 1 5.5,8 Z M 8,1.75 L 8,3.25 M 8,12.75 L 8,14.25 M 1.75,8 L 3.25,8 M 12.75,8 L 14.25,8 M 3.6,3.6 L 4.65,4.65 M 11.35,11.35 L 12.4,12.4 M 3.6,12.4 L 4.65,11.35 M 11.35,4.65 L 12.4,3.6</StreamGeometry>
    <!-- Swap: one arrow up, one down, for exchanging A and B. -->
    <StreamGeometry x:Key="Icon.Swap">M 5,13.25 L 5,2.75 M 2.75,5 L 5,2.75 L 7.25,5 M 11,2.75 L 11,13.25 M 8.75,11 L 11,13.25 L 13.25,11</StreamGeometry>
    <!-- Sort: three lines, longest first. -->
    <StreamGeometry x:Key="Icon.Sort">M 2.75,4.25 L 13.25,4.25 M 2.75,8 L 10.25,8 M 2.75,11.75 L 7.25,11.75</StreamGeometry>
    <!-- A window with its left panel: shows and hides the Tune rail. -->
    <StreamGeometry x:Key="Icon.PanelLeft">M 2.75,3.25 L 13.25,3.25 L 13.25,12.75 L 2.75,12.75 Z M 6.25,3.25 L 6.25,12.75</StreamGeometry>
    <!-- Window buttons: the shapes Windows uses, on the same grid and stroke. -->
    <StreamGeometry x:Key="Icon.WindowMinimize">M 3.5,8 L 12.5,8</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowMaximize">M 3.75,3.75 L 12.25,3.75 L 12.25,12.25 L 3.75,12.25 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowRestore">M 3.75,5.75 L 10.25,5.75 L 10.25,12.25 L 3.75,12.25 Z M 5.75,5.75 L 5.75,3.75 L 12.25,3.75 L 12.25,10.25 L 10.25,10.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowClose">M 3.75,3.75 L 12.25,12.25 M 12.25,3.75 L 3.75,12.25</StreamGeometry>
    <StreamGeometry x:Key="Icon.Info">M 1.75,8 A 6.25,6.25 0 1 1 14.25,8 A 6.25,6.25 0 1 1 1.75,8 Z M 8,7 L 8,11.5 M 8,4.5 L 8,6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M 3.25,8.25 L 6.5,11.5 L 12.75,4.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Gear">M 6.45,3.51 L 6.71,1.37 L 9.29,1.37 L 9.55,3.51 L 11.12,4.42 L 13.09,3.57 L 14.38,5.8 L 12.66,7.09 L 12.66,8.91 L 14.38,10.2 L 13.09,12.43 L 11.12,11.58 L 9.55,12.49 L 9.29,14.63 L 6.71,14.63 L 6.45,12.49 L 4.88,11.58 L 2.91,12.43 L 1.62,10.2 L 3.34,8.91 L 3.34,7.09 L 1.62,5.8 L 2.91,3.57 L 4.88,4.42 Z M 6,8 A 2,2 0 1 1 10,8 A 2,2 0 1 1 6,8 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Minus">M 3.25,8 L 12.75,8</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M 3.25,8 L 12.75,8 M 8,3.25 L 8,12.75</StreamGeometry>

    <!-- Item kinds: tell a map, curve, value, switch, flag and axis apart in a list of ids. -->
    <StreamGeometry x:Key="Kind.Map">M 2.75,2.75 L 13.25,2.75 L 13.25,13.25 L 2.75,13.25 Z M 6.25,2.75 L 6.25,13.25 M 9.75,2.75 L 9.75,13.25 M 2.75,6.25 L 13.25,6.25 M 2.75,9.75 L 13.25,9.75</StreamGeometry>
    <StreamGeometry x:Key="Kind.Curve">M 2,12.5 L 5.5,9 L 8.5,11 L 14,4 M 2,14.25 L 14,14.25</StreamGeometry>
    <StreamGeometry x:Key="Kind.Value">M 6,3 L 10,3 L 10,13 L 6,13 Z</StreamGeometry>
    <StreamGeometry x:Key="Kind.Switch">M 7.25,4.25 L 14,4.25 M 7.25,8 L 14,8 M 7.25,11.75 L 14,11.75</StreamGeometry>
    <StreamGeometry x:Key="Kind.Switch.Fill">M 2,6.5 L 5,6.5 L 5,9.5 L 2,9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Kind.Flag">M 3.75,15 L 3.75,1.5 M 3.75,2.5 L 13,2.5 L 10.25,6 L 13,9.5 L 3.75,9.5</StreamGeometry>
    <StreamGeometry x:Key="Kind.Axis">M 1.5,12.25 L 14.5,12.25 M 2.25,12.25 L 2.25,6.5 M 5.5,12.25 L 5.5,9 M 8.25,12.25 L 8.25,6.5 M 10.5,12.25 L 10.5,9 M 12.25,12.25 L 12.25,9 M 13.75,12.25 L 13.75,6.5</StreamGeometry>

    <!--
        Cell and row markers, drawn 6 px wide: changed is a filled corner triangle, differs a ring. Like every
        icon they sit on the 16 unit grid; StrokeIcon scales the shape, never the 1.5 px stroke.
    -->
    <StreamGeometry x:Key="Mark.Changed">M 0,0 L 16,0 L 16,16 Z</StreamGeometry>
    <StreamGeometry x:Key="Mark.Differs">M 2,8 A 6,6 0 1 1 14,8 A 6,6 0 1 1 2,8 Z</StreamGeometry>
</ResourceDictionary>
