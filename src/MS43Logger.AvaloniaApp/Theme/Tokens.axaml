            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDEAE4" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3ADBA" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#6A7480" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#6A7480" />
            <SolidColorBrush x:Key="SectionLabelBrush" Color="#A3ADBA" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E1116" />
            <SolidColorBrush x:Key="InputForegroundBrush" Color="#EDEAE4" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#344150" />
