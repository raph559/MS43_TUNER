            <Color x:Key="RedZoneColor">#A9302B</Color>
            <SolidColorBrush x:Key="RedZoneBrush" Color="#A9302B" />
            <Color x:Key="FaceColor">#0F1318</Color>
            <SolidColorBrush x:Key="FaceBrush" Color="#0F1318" />
            <Color x:Key="TickColor">#C9CED6</Color>
            <SolidColorBrush x:Key="TickBrush" Color="#C9CED6" />
            <Color x:Key="DownColor">#4C8DFF</Color>
            <SolidColorBrush x:Key="DownBrush" Color="#4C8DFF" />
            <Color x:Key="UpColor">#FF5C7A</Color>
            <SolidColorBrush x:Key="UpBrush" Color="#FF5C7A" />
            <Color x:Key="OkColor">#5CC48A</Color>
            <SolidColorBrush x:Key="OkBrush" Color="#5CC48A" />
            <Color x:Key="NeedleGlowColor">#8CFF6A1A</Color>
            <SolidColorBrush x:Key="NeedleSoftBrush" Color="#26FF6A1A" />
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1116" />
