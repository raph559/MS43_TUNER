<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens: docs/superpowers/specs/2026-10-20-ms43-restyle-system.md, sections 1 to 4. Day is look A, Night is look B. -->
    <!--
        Segoe UI, not Segoe UI Variable: Avalonia reaches only the default instance of a variable font, so Segoe UI
        Variable has no SemiBold here, while Segoe UI ships a real Semibold face. Bahnschrift likewise renders its
        Regular instance only (SemiLight and SemiCondensed are out of reach); its 600 is Avalonia's synthetic bold.
    -->
    <FontFamily x:Key="UiFont">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="UiDisplayFont">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="DataFont">Bahnschrift, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <!-- Scroll bars: 10 px when shown (Fluent's 16 px bar with arrows covered the grid's last row). -->
    <x:Double x:Key="ScrollBarSize">10</x:Double>
    <FontFamily x:Key="MonoFont">Cascadia Mono, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="FrameColor">#F2F4F7</Color>
            <SolidColorBrush x:Key="FrameBrush" Color="#F2F4F7" />
            <Color x:Key="PaneColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="PaneBrush" Color="#FFFFFF" />
            <Color x:Key="FillColor">#E9ECF1</Color>
            <SolidColorBrush x:Key="FillBrush" Color="#E9ECF1" />
            <Color x:Key="TrackColor">#F2F4F7</Color>
            <SolidColorBrush x:Key="TrackBrush" Color="#F2F4F7" />
            <Color x:Key="HairlineColor">#E1E5EA</Color>
            <SolidColorBrush x:Key="HairlineBrush" Color="#E1E5EA" />
            <Color x:Key="EdgeColor">#727C8C</Color>
            <SolidColorBrush x:Key="EdgeBrush" Color="#727C8C" />
            <!-- Buttons, pickers, tool groups and the selected segment: a filled surface with a soft edge, not the Edge outline (the
                 label names a button; Edge stays on text fields and switch tracks, which have no label inside). -->
            <Color x:Key="ButtonColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF" />
            <Color x:Key="ButtonEdgeColor">#CDD3DB</Color>
            <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#CDD3DB" />
            <Color x:Key="ButtonRaisedColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="ButtonRaisedBrush" Color="#FFFFFF" />
            <Color x:Key="Ink1Color">#121826</Color>
            <SolidColorBrush x:Key="Ink1Brush" Color="#121826" />
            <Color x:Key="Ink2Color">#3D4656</Color>
            <SolidColorBrush x:Key="Ink2Brush" Color="#3D4656" />
            <Color x:Key="Ink3Color">#5B6576</Color>
            <SolidColorBrush x:Key="Ink3Brush" Color="#5B6576" />
            <Color x:Key="NowColor">#EA5B0C</Color>
            <SolidColorBrush x:Key="NowBrush" Color="#EA5B0C" />
            <Color x:Key="NowTextColor">#B4470A</Color>
            <SolidColorBrush x:Key="NowTextBrush" Color="#B4470A" />
            <Color x:Key="WarnColor">#B42318</Color>
            <SolidColorBrush x:Key="WarnBrush" Color="#B42318" />
            <!-- Close-button hover: Day's warn red in both themes, so its white glyph stays at 6.6:1. -->
            <SolidColorBrush x:Key="CaptionCloseBrush" Color="#B42318" />
            <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#8F1C13" />
            <Color x:Key="Map1Color">#CCF1EA</Color>
            <SolidColorBrush x:Key="Map1Brush" Color="#CCF1EA" />
            <Color x:Key="Map2Color">#9EDFE0</Color>
            <SolidColorBrush x:Key="Map2Brush" Color="#9EDFE0" />
            <Color x:Key="Map3Color">#6DC7DB</Color>
            <SolidColorBrush x:Key="Map3Brush" Color="#6DC7DB" />
            <Color x:Key="Map4Color">#4FAAD3</Color>
            <SolidColorBrush x:Key="Map4Brush" Color="#4FAAD3" />
            <Color x:Key="Map5Color">#3D89C6</Color>
            <SolidColorBrush x:Key="Map5Brush" Color="#3D89C6" />
            <Color x:Key="Map6Color">#3568B2</Color>
            <SolidColorBrush x:Key="Map6Brush" Color="#3568B2" />
            <Color x:Key="Map7Color">#324496</Color>
            <SolidColorBrush x:Key="Map7Brush" Color="#324496" />
            <Color x:Key="DivBelowColor">#1F53B8</Color>
            <SolidColorBrush x:Key="DivBelowBrush" Color="#1F53B8" />
            <Color x:Key="DivAboveColor">#CE2854</Color>
            <SolidColorBrush x:Key="DivAboveBrush" Color="#CE2854" />
            <Color x:Key="PopupColor">#FFFFFF</Color>
            <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
            <Color x:Key="PopupEdgeColor">#E1E5EA</Color>
            <SolidColorBrush x:Key="PopupEdgeBrush" Color="#E1E5EA" />
            <Color x:Key="DialogSegTrackColor">#E9ECF1</Color>
            <SolidColorBrush x:Key="DialogSegTrackBrush" Color="#E9ECF1" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0F121826" />
            <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1F121826" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#4D121826" />
            <BoxShadows x:Key="PopupShadow">0 8 24 -8 #3D121826</BoxShadows>

            <!-- Fluent's own keys, pointed at the tokens, so its switches, checkboxes and popups follow the system in every state. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#727C8C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#727C8C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#727C8C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#E1E5EA" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#5B6576" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#5B6576" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#5B6576" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#E1E5EA" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#121826" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3D4656" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#121826" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#E9ECF1" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#121826" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#5B6576" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#121826" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#727C8C" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#727C8C" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#121826" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#3D4656" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#121826" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#3D4656" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#121826" />
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#121826" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#E1E5EA" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0F121826" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E9ECF1" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#121826" />
            <!-- Keyboard focus on a picker keeps its surface and ink; the focus ring alone marks it (Fluent's accent highlight is cleared). -->
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#00000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#CDD3DB" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#CDD3DB" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#121826" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#121826" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#5B6576" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#3D4656" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#3D4656" />
            <!-- Scroll bars: an Edge thumb (3:1 on every surface), no track; Fluent's translucent white thumb was 1.85:1 on a Night dialog. -->
            <Color x:Key="ScrollBarThumbBackgroundColor">#727C8C</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#727C8C</Color>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#5B6576" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#3D4656" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#3D4656" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#121826" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#121826" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#5B6576" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#E1E5EA" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#E1E5EA" />
            <!-- Text selection on the map's Map3 stop, where Ink1 text keeps 4.5:1 or more. No blue accent anywhere. -->
            <Color x:Key="TextControlSelectionHighlightColor">#6DC7DB</Color>
            <Color x:Key="SystemAccentColor">#121826</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="FrameColor">#101215</Color>
            <SolidColorBrush x:Key="FrameBrush" Color="#101215" />
            <Color x:Key="PaneColor">#0A0B0D</Color>
            <SolidColorBrush x:Key="PaneBrush" Color="#0A0B0D" />
            <Color x:Key="FillColor">#1F2328</Color>
            <SolidColorBrush x:Key="FillBrush" Color="#1F2328" />
            <Color x:Key="TrackColor">#1F2328</Color>
            <SolidColorBrush x:Key="TrackBrush" Color="#1F2328" />
            <Color x:Key="HairlineColor">#23272D</Color>
            <SolidColorBrush x:Key="HairlineBrush" Color="#23272D" />
            <Color x:Key="EdgeColor">#6E7681</Color>
            <SolidColorBrush x:Key="EdgeBrush" Color="#6E7681" />
            <Color x:Key="ButtonColor">#1F2328</Color>
            <SolidColorBrush x:Key="ButtonBrush" Color="#1F2328" />
            <Color x:Key="ButtonEdgeColor">#30363D</Color>
            <SolidColorBrush x:Key="ButtonEdgeBrush" Color="#30363D" />
            <Color x:Key="ButtonRaisedColor">#2D333B</Color>
            <SolidColorBrush x:Key="ButtonRaisedBrush" Color="#2D333B" />
            <Color x:Key="Ink1Color">#F3F5F7</Color>
            <SolidColorBrush x:Key="Ink1Brush" Color="#F3F5F7" />
            <Color x:Key="Ink2Color">#AEB4BD</Color>
            <SolidColorBrush x:Key="Ink2Brush" Color="#AEB4BD" />
            <Color x:Key="Ink3Color">#858C97</Color>
            <SolidColorBrush x:Key="Ink3Brush" Color="#858C97" />
            <Color x:Key="NowColor">#FF7A1A</Color>
            <SolidColorBrush x:Key="NowBrush" Color="#FF7A1A" />
            <Color x:Key="NowTextColor">#FF7A1A</Color>
            <SolidColorBrush x:Key="NowTextBrush" Color="#FF7A1A" />
            <Color x:Key="WarnColor">#FF6259</Color>
            <SolidColorBrush x:Key="WarnBrush" Color="#FF6259" />
            <SolidColorBrush x:Key="CaptionCloseBrush" Color="#B42318" />
            <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#8F1C13" />
            <Color x:Key="Map1Color">#02423A</Color>
            <SolidColorBrush x:Key="Map1Brush" Color="#02423A" />
            <Color x:Key="Map2Color">#005C5E</Color>
            <SolidColorBrush x:Key="Map2Brush" Color="#005C5E" />
            <Color x:Key="Map3Color">#077688</Color>
            <SolidColorBrush x:Key="Map3Brush" Color="#077688" />
            <Color x:Key="Map4Color">#368EB3</Color>
            <SolidColorBrush x:Key="Map4Brush" Color="#368EB3" />
            <Color x:Key="Map5Color">#68A4D9</Color>
            <SolidColorBrush x:Key="Map5Brush" Color="#68A4D9" />
            <Color x:Key="Map6Color">#97BDF4</Color>
            <SolidColorBrush x:Key="Map6Brush" Color="#97BDF4" />
            <Color x:Key="Map7Color">#C8D6FF</Color>
            <SolidColorBrush x:Key="Map7Brush" Color="#C8D6FF" />
            <Color x:Key="DivBelowColor">#6CA7F5</Color>
            <SolidColorBrush x:Key="DivBelowBrush" Color="#6CA7F5" />
            <Color x:Key="DivAboveColor">#F87F99</Color>
            <SolidColorBrush x:Key="DivAboveBrush" Color="#F87F99" />
            <Color x:Key="PopupColor">#1F2328</Color>
            <SolidColorBrush x:Key="PopupBrush" Color="#1F2328" />
            <Color x:Key="PopupEdgeColor">#6E7681</Color>
            <SolidColorBrush x:Key="PopupEdgeBrush" Color="#6E7681" />
            <Color x:Key="DialogSegTrackColor">#101215</Color>
            <SolidColorBrush x:Key="DialogSegTrackBrush" Color="#101215" />
            <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14F3F5F7" />
            <SolidColorBrush x:Key="PressedOverlayBrush" Color="#24F3F5F7" />
            <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
            <!-- No shadow at Night: on #0A0B0D it is invisible, so popups separate with Edge instead (system 4.3). -->
            <BoxShadows x:Key="PopupShadow">0 0 0 0 #00000000</BoxShadows>

            <!-- Fluent's own keys, pointed at the tokens, so its switches, checkboxes and popups follow the system in every state. -->
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#6E7681" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#6E7681" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#6E7681" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#23272D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#858C97" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#858C97" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#858C97" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#23272D" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#AEB4BD" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#1F2328" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#858C97" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="#F3F5F7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#0A0B0D" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#0A0B0D" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#0A0B0D" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#6E7681" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#6E7681" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#F3F5F7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#AEB4BD" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#F3F5F7" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#AEB4BD" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0A0B0D" />
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#F3F5F7" />
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1F2328" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#6E7681" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#14F3F5F7" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0A0B0D" />
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#F3F5F7" />
            <!-- Keyboard focus on a picker keeps its surface and ink; the focus ring alone marks it (Fluent's accent highlight is cleared). -->
            <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#00000000" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="#30363D" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#30363D" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" Color="#858C97" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#AEB4BD" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#AEB4BD" />
            <!-- Scroll bars: an Edge thumb (3:1 on every surface), no track; Fluent's translucent white thumb was 1.85:1 on a Night dialog. -->
            <Color x:Key="ScrollBarThumbBackgroundColor">#6E7681</Color>
            <Color x:Key="ScrollBarPanningThumbBackgroundColor">#6E7681</Color>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#858C97" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#AEB4BD" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#00000000" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#AEB4BD" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#F3F5F7" />
            <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#858C97" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1F2328" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#6E7681" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#1F2328" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#6E7681" />
            <!-- Text selection on the map's Map3 stop, where Ink1 text keeps 4.5:1 or more. No blue accent anywhere. -->
            <Color x:Key="TextControlSelectionHighlightColor">#077688</Color>
            <Color x:Key="SystemAccentColor">#F3F5F7</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
