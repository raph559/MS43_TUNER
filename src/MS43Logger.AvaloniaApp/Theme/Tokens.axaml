            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#D5DBE2" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#141A21" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#455160" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#788392" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#788392" />
            <SolidColorBrush x:Key="SectionLabelBrush" Color="#455160" />
            <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E6E9ED" />
            <SolidColorBrush x:Key="InputForegroundBrush" Color="#141A21" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#B9C2CD" />
            <SolidColorBrush x:Key="NeutralButtonBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NeutralButtonForegroundBrush" Color="#141A21" />
            <SolidColorBrush x:Key="ConnectButtonBackgroundBrush" Color="#141A21" />
            <SolidColorBrush x:Key="ConnectButtonForegroundBrush" Color="#E6E9ED" />
            <SolidColorBrush x:Key="StatusBadgeBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="StatusBadgeTextBrush" Color="#141A21" />
            <SolidColorBrush x:Key="StatusConnectedBrush" Color="#E05206" />
            <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#788392" />
            <SolidColorBrush x:Key="TipBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TipHeaderBrush" Color="#455160" />
            <SolidColorBrush x:Key="TipTextBrush" Color="#455160" />
            <SolidColorBrush x:Key="PinButtonBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PinButtonForegroundBrush" Color="#141A21" />
            <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="FooterForegroundBrush" Color="#788392" />
            <SolidColorBrush x:Key="FooterAccentBrush" Color="#141A21" />
