            <SolidColorBrush x:Key="TipBackgroundBrush" Color="#1B222B" />
            <SolidColorBrush x:Key="TipHeaderBrush" Color="#A3ADBA" />
            <SolidColorBrush x:Key="TipTextBrush" Color="#A3ADBA" />
            <SolidColorBrush x:Key="PinButtonBackgroundBrush" Color="#1B222B" />
            <SolidColorBrush x:Key="PinButtonForegroundBrush" Color="#EDEAE4" />
            <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#141920" />
