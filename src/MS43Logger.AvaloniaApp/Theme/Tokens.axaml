<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens from the approved mockup (docs/superpowers/mockups/ms43-tuner-mockup.html). -->
    <FontFamily x:Key="DisplayFont">Bahnschrift, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="DialColor">#0E1116</Color>
            <SolidColorBrush x:Key="DialBrush" Color="#0E1116" />
            <Color x:Key="PaneColor">#141920</Color>
            <SolidColorBrush x:Key="PaneBrush" Color="#141920" />
            <Color x:Key="RaisedColor">#1B222B</Color>
            <SolidColorBrush x:Key="RaisedBrush" Color="#1B222B" />
            <Color x:Key="SunkenColor">#0A0D11</Color>
            <SolidColorBrush x:Key="SunkenBrush" Color="#0A0D11" />
            <Color x:Key="BezelColor">#222A34</Color>
            <SolidColorBrush x:Key="BezelBrush" Color="#222A34" />
            <Color x:Key="Bezel2Color">#344150</Color>
            <SolidColorBrush x:Key="Bezel2Brush" Color="#344150" />
            <Color x:Key="InkColor">#EDEAE4</Color>
            <SolidColorBrush x:Key="InkBrush" Color="#EDEAE4" />
            <Color x:Key="Ink2Color">#A3ADBA</Color>
            <SolidColorBrush x:Key="Ink2Brush" Color="#A3ADBA" />
            <Color x:Key="Ink3Color">#6A7480</Color>
            <SolidColorBrush x:Key="Ink3Brush" Color="#6A7480" />
            <Color x:Key="NeedleColor">#FF6A1A</Color>
