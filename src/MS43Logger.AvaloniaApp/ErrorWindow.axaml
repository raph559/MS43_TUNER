<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="MS43Logger.AvaloniaApp.ErrorWindow"
        Title="Connection Error"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        Width="650" Height="450"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="CONNECTION FAILED"
                       FontSize="18"
                       FontWeight="Black"
                       Foreground="#ff4e6a"/>
            <TextBlock Text="Detailed Error Logs:"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="ErrorTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Foreground="{DynamicResource MutedTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         FontFamily="Consolas, Courrier New, Monospace"
                         FontSize="11"
                         Padding="12"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CLOSE"
                    Click="CloseButton_Click"
                    Background="{DynamicResource NeutralButtonBackgroundBrush}"
                    Foreground="{DynamicResource NeutralButtonForegroundBrush}"/>
        </StackPanel>
    </Grid>
</Window>