<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MS43Logger.AvaloniaApp"
        xmlns:controls="using:MS43Logger.AvaloniaApp.Controls"
        x:Class="MS43Logger.AvaloniaApp.PerformanceWindow"
        x:DataType="local:MainWindowViewModel"
        Title="Performance tests"
        Background="{DynamicResource PaneBrush}"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- A time in Data 40 with its unit in UI Ink3, as every reading (system 3.2); before a run, n/a in UI Ink3 (7.2). -->
        <Style Selector="TextBlock.time">
            <Setter Property="Foreground" Value="{DynamicResource Ink1Brush}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="TextBlock.time Run.unit">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>
        <Style Selector="TextBlock.time.na">
            <Setter Property="FontFamily" Value="{DynamicResource UiDisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="24" Spacing="20">
        <!-- What the run waits for, beside the control that starts it; when the definition has no speed channel the line
             says so, since a tooltip alone never holds the reason (system 5.9). -->
        <DockPanel MinHeight="32">
            <Button Name="StartTestButton" DockPanel.Dock="Right" Classes="primary" Content="Start test" Click="StartTest_Click"
                    IsEnabled="{Binding HasSpeedChannel}" ToolTip.Tip="{Binding StartTestTip}" ToolTip.ShowOnDisabled="True"
                    VerticalAlignment="Center" />
            <TextBlock Name="PerformanceStatus" Classes="body" Foreground="{DynamicResource Ink2Brush}" Text="{Binding PerformanceStatus}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <Grid ColumnDefinitions="*,12,*">
            <Border Grid.Column="0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="0 to 100 km/h" />
                    <Panel Height="44">
                        <controls:ReadingText Name="Time100Text" Classes="data40 time" Classes.na="{Binding !HasTime100}" Value="{Binding Time100}" Unit="s" />
                    </Panel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="0 to 200 km/h" />
                    <Panel Height="44">
                        <controls:ReadingText Name="Time200Text" Classes="data40 time" Classes.na="{Binding !HasTime200}" Value="{Binding Time200}" Unit="s" />
                    </Panel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Window>
