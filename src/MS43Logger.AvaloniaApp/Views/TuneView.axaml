<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MS43Logger.AvaloniaApp"
             xmlns:controls="using:MS43Logger.AvaloniaApp.Controls"
             xmlns:core="using:MS43Logger.Core.Tuning"
             x:Class="MS43Logger.AvaloniaApp.Views.TuneView"
             x:DataType="local:TuneViewModel">
    <UserControl.Styles>
        <!-- Rail (system 5.6, 8): 256 px Frame, 224 px below 1280. -->
        <Style Selector="Border#RailHost">
            <Setter Property="Width" Value="256" />
        </Style>
        <Style Selector="Window.compact Border#RailHost">
            <Setter Property="Width" Value="224" />
        </Style>
        <!-- Rows draw their own state from the rail's data: the list's selection only lasts until the rail rebuilds. -->
        <Style Selector="ListBox#RailList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox#RailList ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="ListBox#RailList ListBoxItem:selected /template/ Border#PART_Bar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Border.row.indented">
            <Setter Property="Padding" Value="28,0,8,0" />
        </Style>
        <Style Selector="Border.row.current">
            <Setter Property="Background" Value="{DynamicResource FillBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink1Brush}" />
        </Style>
        <Style Selector="Border.row.current TextBlock.id">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.row.open">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink1Brush}" />
        </Style>
        <Style Selector="Border.currentbar">
            <Setter Property="Margin" Value="-8,6,0,6" />
        </Style>
        <Style Selector="Border.currentbar.indented">
            <Setter Property="Margin" Value="-28,6,0,6" />
        </Style>
        <!-- A category's count is Ink3, which falls under 4.5:1 on the pressed overlay (3.79 Night, 4.20 Day): it rises to Ink2. -->
        <Style Selector="TextBlock.count">
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>
        <Style Selector="ListBox#RailList ListBoxItem:pressed TextBlock.count">
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        </Style>
        <Style Selector="TextBlock.id">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
            <Setter Property="Margin" Value="8,8,8,4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- Pane (system 8): padding 24, 16 below 1280; the toolbar and the grid 24 below what is above them, 16 below 1280. -->
        <Style Selector="Border#PaneHost">
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="Window.compact Border#PaneHost">
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="WrapPanel#ToolBar, controls|TableLayout#TableArea">
            <Setter Property="Margin" Value="0,24,0,0" />
        </Style>
        <Style Selector="Window.compact WrapPanel#ToolBar, Window.compact controls|TableLayout#TableArea">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style Selector="Border.banner">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <!-- A one-column table sits centred with its key line (system 8, owner); a map keeps the cells' left edge. -->
        <Style Selector="controls|MapGrid#MapGrid">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="controls|TableLayout#TableArea.centred controls|MapGrid#MapGrid">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel#KeyArea">
            <Setter Property="Margin" Value="50,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="controls|TableLayout#TableArea.centred StackPanel#KeyArea">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- A value's reading: the unit in UI 13 Ink3 on the Data 56 baseline (system 5.13). -->
        <Style Selector="TextBlock#ValueReading Run.unit">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        </Style>
        <Style Selector="DockPanel#LimitsLegendLine TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        </Style>
        <!-- A switch's choices (system 5.13): an Edge-bordered list; the chosen row has the selected-row look and a check. -->
        <Style Selector="ListBox#ChoiceList">
            <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox#ChoiceList ListBoxItem">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0,10,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox#ChoiceList ListBoxItem:selected /template/ Border#PART_Bar">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <!-- The raw number is Ink2, Ink1 when chosen: Ink3 falls to 3.89:1 on a pressed chosen row (Day). -->
        <Style Selector="TextBlock.choice-raw">
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="ListBox#ChoiceList ListBoxItem:selected TextBlock.choice-raw">
            <Setter Property="Foreground" Value="{DynamicResource Ink1Brush}" />
        </Style>
        <Style Selector="WrapPanel#KeyLine TextBlock, WrapPanel#ValueKeyLine TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Inspector (system 8): 312 px Frame; below 1280 an overlay from the right, opened by Details. -->
        <Style Selector="Panel#InspectorSlot">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <!-- The overlay starts under the title row (16 padding + 32 row + 8), so Details stays there to close it. -->
        <Style Selector="Window.compact Panel#InspectorSlot">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,56,0,0" />
        </Style>
        <Style Selector="Window.compact Border#InspectorHost">
            <Setter Property="IsVisible" Value="{ReflectionBinding InspectorOpen}" />
            <Setter Property="Background" Value="{DynamicResource PopupBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PopupEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BoxShadow" Value="{DynamicResource PopupShadow}" />
        </Style>
        <Style Selector="Button#DetailsToggle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Window.compact Button#DetailsToggle">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border#InspectorHost TextBlock.h2">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink1Brush}" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="Margin" Value="-16,16" />
        </Style>
        <Style Selector="Grid.fact TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
    </UserControl.Styles>

    <Grid Name="TuneRoot" ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding !IsBusy}">
        <!-- Rail -->
        <Border Name="RailHost" Background="{DynamicResource FrameBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                Padding="12,12,8,8" IsVisible="{Binding HasDocument}">
            <DockPanel>
                <TextBox Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,4,0" Height="32" Text="{Binding SearchText}" Watermark="Search items"
                         AutomationProperties.Name="Search items">
                    <TextBox.InnerLeftContent>
                        <controls:StrokeIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    </TextBox.InnerLeftContent>
                    <TextBox.InnerRightContent>
                        <Border Classes="kbd" VerticalAlignment="Center" Margin="8,0,6,0">
                            <TextBlock Text="Ctrl K" />
                        </Border>
                    </TextBox.InnerRightContent>
                </TextBox>
                <ToggleSwitch Name="ModifiedOnlySwitch" DockPanel.Dock="Top" Margin="4,8,0,0" IsChecked="{Binding ModifiedOnly}"
                              OnContent="Changed only" OffContent="Changed only" AutomationProperties.Name="Changed only" />
                <ToggleSwitch Name="DiffersOnlyBox" DockPanel.Dock="Top" Margin="4,4,0,0" IsChecked="{Binding DiffersOnly}" IsVisible="{Binding HasCompare}"
                              OnContent="Differs from B" OffContent="Differs from B" AutomationProperties.Name="Differs from B"
                              ToolTip.Tip="{Binding CompareFileB, StringFormat='Items that differ from {0} (B on the Compare tab)'}" />
                <StackPanel DockPanel.Dock="Top" Margin="8,16,8,0" Spacing="8" IsVisible="{Binding NoMatchText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Name="NoMatchText" Classes="body" Text="{Binding NoMatchText}" TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}" />
                    <Button Name="ClearSearchButton" Classes="quiet" Content="Clear search" Click="ClearSearch_Click" Margin="-10,0,0,0" />
                </StackPanel>
                <ListBox Name="RailList" Margin="0,8,0,0" ItemsSource="{Binding Rail}" SelectionChanged="Rail_SelectionChanged">
                    <ListBox.DataTemplates>
                        <DataTemplate DataType="local:RailGroup">
                            <TextBlock Classes="group" Text="{Binding Title}" />
                        </DataTemplate>
                        <DataTemplate DataType="local:RailCategory">
                            <Border Classes="row" Classes.open="{Binding IsExpanded}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Panel Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <controls:StrokeIcon Data="{StaticResource Icon.ChevronRight}" Width="14" Height="14" IsVisible="{Binding !IsExpanded}" />
                                        <controls:StrokeIcon Data="{StaticResource Icon.ChevronDown}" Width="14" Height="14" IsVisible="{Binding IsExpanded}" />
                                    </Panel>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="data12 count" Text="{Binding Count}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                        <DataTemplate DataType="local:RailItem">
                            <Border Classes="row" Classes.indented="{Binding IsIndented}" Classes.current="{Binding IsCurrent}">
                                <Panel>
                                    <Border Classes="currentbar" Classes.indented="{Binding IsIndented}" Width="2" HorizontalAlignment="Left"
                                            Background="{DynamicResource Ink1Brush}" IsVisible="{Binding IsCurrent}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <controls:ItemGlyph Kind="{Binding Kind}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="id" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Title}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <controls:StrokeIcon Name="ChangedMark" FillData="{StaticResource Mark.Changed}" Width="6" Height="6" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Ink1Brush}" IsVisible="{Binding IsModified}" ToolTip.Tip="Changed since the last save" />
                                            <controls:StrokeIcon Name="DiffersMark" Data="{StaticResource Mark.Differs}" Width="8" Height="8" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Ink1Brush}" IsVisible="{Binding IsDifferent}" ToolTip.Tip="Differs from B on the Compare tab" />
                                            <controls:StrokeIcon Name="PinnedMark" Data="{StaticResource Icon.PinFilled}" FillData="{StaticResource Icon.PinFilled.Fill}"
                                                                 Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource Ink1Brush}"
                                                                 IsVisible="{Binding IsPinned}" ToolTip.Tip="Pinned" />
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pane: title row, banners, toolbar, then the item -->
        <Border Name="PaneHost" Grid.Column="1" Background="{DynamicResource PaneBrush}">
            <DockPanel Name="TunePane">
                <Grid Name="TitleRow" DockPanel.Dock="Top" Height="32" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                      IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <controls:ItemGlyph Kind="{Binding SelectedKind}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Ink2Brush}" />
                    <TextBlock Name="ItemTitle" Grid.Column="1" Classes="mono13" Text="{Binding SelectedItem.Title, FallbackValue=''}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink1Brush}" />
                    <TextBlock Name="ItemDescription" Grid.Column="2" Classes="body" Margin="12,0,12,0" Text="{Binding SelectedItem.Description, FallbackValue=''}"
                               Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding SelectedItem.Description, FallbackValue=''}" />
                    <Border Name="ReadOnlyChip" Grid.Column="3" Classes="chip" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsReadOnlyItem}">
                        <TextBlock Text="Read-only" />
                    </Border>
                    <Button Name="PinButton" Grid.Column="4" Classes="quiet" Click="Pin_Click" VerticalAlignment="Center" ToolTip.Tip="Pin to the top of the rail"
                            AutomationProperties.Name="{Binding PinText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <controls:StrokeIcon Data="{StaticResource Icon.Pin}" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PinText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Name="DetailsToggle" Grid.Column="5" Classes="quiet" Content="Details" Click="Details_Click" VerticalAlignment="Center"
                            ToolTip.Tip="Edit limits, surface, details and colour scale" />
                </Grid>
                <!-- Info lines under the title (system 7.1): inline, the info icon, no box. -->
                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" IsVisible="{Binding IsReadOnlyItem}">
                    <controls:StrokeIcon Data="{StaticResource Icon.Info}" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Name="ReadOnlyLine" Classes="body" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0" IsVisible="{Binding IsAxis}">
                    <controls:StrokeIcon Data="{StaticResource Icon.Info}" Margin="0,1,8,0" VerticalAlignment="Top" />
                    <TextBlock Name="AxisRuleText" Classes="body" TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}"
                               Text="Breakpoints must not go down: an edit that makes one fall below its neighbour is refused." />
                </DockPanel>

                <Border Name="ErrorBanner" DockPanel.Dock="Top" Classes="banner warn" IsVisible="{Binding HasErrorBanner}">
                    <DockPanel>
                        <controls:StrokeIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Warn}" Foreground="{DynamicResource WarnBrush}" Width="16" Height="16"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button Name="ErrorActionButton" DockPanel.Dock="Right" Margin="12,0,0,0" Content="{Binding ErrorActionText}" Click="ErrorAction_Click"
                                VerticalAlignment="Center" IsVisible="{Binding ErrorActionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Name="EditError" Classes="body" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Ink1Brush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border Name="FirmwareBanner" DockPanel.Dock="Top" Classes="banner warn"
                        IsVisible="{Binding FirmwareWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <DockPanel>
                        <controls:StrokeIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Warn}" Foreground="{DynamicResource WarnBrush}" Width="16" Height="16"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Content="Use another XDF…" Click="UseAnotherXdf_Click" VerticalAlignment="Center" />
                        <TextBlock Classes="body" Text="{Binding FirmwareWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Ink1Brush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Toolbar: cell operations on tables; Undo and Redo for every item. A read-only item disables it with the reason. -->
                <WrapPanel Name="ToolBar" DockPanel.Dock="Top" ItemSpacing="12" LineSpacing="8"
                           IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                           IsEnabled="{Binding !IsReadOnlyItem}" ToolTip.Tip="{Binding ReadOnlyReason}" ToolTip.ShowOnDisabled="True">
                    <TextBox Name="ToolValue" Width="120" Height="32" Classes="data13" Watermark="Value" Text="{Binding ToolValue}" KeyDown="ToolValue_KeyDown"
                             AutomationProperties.Name="Value" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBox.InnerRightContent>
                            <TextBlock Classes="meta" Text="{Binding Editor.Units, FallbackValue=''}" VerticalAlignment="Center" Margin="6,0,10,0" />
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <Border Classes="toolgroup" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="SetTool" Content="Set" Tag="Set" Click="Tool_Click" ToolTip.Tip="Set the selected cells to the value (Enter)" />
                            <Button Name="AddTool" Content="Add" Tag="Add" Click="Tool_Click" ToolTip.Tip="Add the value to the selected cells" />
                            <Button Name="ScaleTool" Content="Scale %" Tag="Scale" Click="Tool_Click" ToolTip.Tip="Change the selected cells by that many percent" />
                        </StackPanel>
                    </Border>
                    <Border Classes="toolgroup" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="InterpolateTool" Content="Interpolate" Tag="Interpolate" Click="Tool_Click"
                                    IsEnabled="{Binding Editor.CanInterpolate, FallbackValue=False}"
                                    ToolTip.Tip="{Binding Editor.InterpolateTip, FallbackValue=''}" ToolTip.ShowOnDisabled="True" />
                            <Button Name="SmoothTool" Content="Smooth" Tag="Smooth" Click="Tool_Click" ToolTip.Tip="Average each cell with its neighbours" />
                        </StackPanel>
                    </Border>
                    <!-- A value's exact entry (system 5.13): the Value field with its unit, then Set, secondary since Save is the primary. -->
                    <TextBox Name="ValueInput" Width="120" Height="32" Classes="data13" Watermark="Value" Text="{Binding Value.Input, FallbackValue=''}"
                             KeyDown="ValueInput_KeyDown" AutomationProperties.Name="Value" IsVisible="{Binding Value.IsValue, FallbackValue=False}">
                        <TextBox.InnerRightContent>
                            <TextBlock Classes="meta" Text="{Binding Value.Units, FallbackValue=''}" VerticalAlignment="Center" Margin="6,0,10,0" />
                        </TextBox.InnerRightContent>
                    </TextBox>
                    <Button Name="SetValueButton" Content="Set" Click="SetValue_Click" IsVisible="{Binding Value.IsValue, FallbackValue=False}"
                            ToolTip.Tip="Store the typed value, snapped to the nearest one the ECU can hold" />
                    <Border Classes="toolgroup">
                        <StackPanel Orientation="Horizontal">
                            <Button Name="UndoTool" Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}" ToolTip.ShowOnDisabled="True" />
                            <Button Name="RedoTool" Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}" ToolTip.ShowOnDisabled="True" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Panel>
                    <!-- A table: the grid, then the key line -->
                    <controls:TableLayout Name="TableArea" Classes.centred="{Binding CentreGrid}" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- The column axis (system 8): its units in UI 12 Ink2, its id in Cascadia Ink3. -->
                        <StackPanel Name="AxisLine" Orientation="Horizontal" Spacing="8" Margin="50,0,0,4" Height="16"
                                    IsVisible="{Binding !CentreGrid}">
                            <TextBlock Classes="label" Text="{Binding Editor.Values.X.Units, FallbackValue=''}" VerticalAlignment="Center" />
                            <TextBlock Classes="mono" FontSize="12" Text="{Binding Editor.Values.X.Name, FallbackValue=''}" Foreground="{DynamicResource Ink3Brush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <controls:MapGrid Name="MapGrid" Editor="{Binding Editor}" VerticalAlignment="Top" MaxWidth="1240" />
                        </ScrollViewer>
                        <StackPanel Name="KeyArea" Spacing="4">
                            <DockPanel IsVisible="{Binding Editor.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                <controls:StrokeIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Warn}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14"
                                                     Margin="0,1,8,0" VerticalAlignment="Top" />
                                <TextBlock Name="EditMessage" Classes="body" Text="{Binding Editor.Message, FallbackValue=''}" TextWrapping="Wrap" />
                            </DockPanel>
                            <WrapPanel Name="KeyLine" ItemSpacing="24" LineSpacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !Editor.IsTyping, FallbackValue=True}">
                                    <Border Width="16" Height="12" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource Ink1Brush}" VerticalAlignment="Center" />
                                    <controls:NumberText Name="KeySelection" Value="{Binding Editor.SelectionText, FallbackValue=''}" />
                                </StackPanel>
                                <controls:NumberText Name="KeyTyping" Value="{Binding Editor.TypingHint, FallbackValue=''}" Foreground="{DynamicResource Ink1Brush}"
                                                     IsVisible="{Binding Editor.IsTyping, FallbackValue=False}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Editor.ChangedText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                    <controls:StrokeIcon FillData="{StaticResource Mark.Changed}" Width="8" Height="8" Foreground="{DynamicResource Ink1Brush}" VerticalAlignment="Center" />
                                    <controls:NumberText Name="KeyChanged" Value="{Binding Editor.ChangedText, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding LiveCursor.Readout, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Ellipse Width="8" Height="8" StrokeThickness="1.5" Stroke="{DynamicResource Ink2Brush}" VerticalAlignment="Center" />
                                    <TextBlock Name="LiveReadout" Classes.live="{Binding LiveCursor.ReadoutIsLive}" Text="{Binding LiveCursor.Readout}" />
                                </StackPanel>
                                <controls:NumberText Name="KeyUndo" Value="{Binding UndoTip}" IsVisible="{Binding CanUndo}" />
                            </WrapPanel>
                        </StackPanel>
                    </controls:TableLayout>

                    <!-- A value, switch or flag (system 5.13, 5.14): the item, then its key line. -->
                    <StackPanel Name="ValueArea" HorizontalAlignment="Left" Margin="0,24,0,0"
                                IsVisible="{Binding Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <!-- A value: the Data 56 reading with its unit, then the slider between - and +. -->
                        <StackPanel IsVisible="{Binding Value.IsValue, FallbackValue=False}">
                            <!-- The runs touch: whitespace between them would be a space set at 56 px. -->
                            <TextBlock Name="ValueReading" Classes="data56" Foreground="{DynamicResource Ink1Brush}"><Run
                                Text="{Binding Value.ReadingText, FallbackValue='', Mode=OneWay}" /><Run Classes="unit" Text="{Binding Value.ReadingUnits, FallbackValue='', Mode=OneWay}" /></TextBlock>
                            <Grid Name="SliderRow" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Left" MaxWidth="600" Margin="0,16,0,0"
                                  IsEnabled="{Binding !IsReadOnlyItem}">
                                <Button Name="StepDownButton" Classes="icon" VerticalAlignment="Top" Click="StepDown_Click"
                                        ToolTip.Tip="{Binding Value.StepDownTip, FallbackValue=''}" AutomationProperties.Name="One step down">
                                    <controls:StrokeIcon Data="{StaticResource Icon.Minus}" />
                                </Button>
                                <controls:ValueSlider Name="ValueSlider" Grid.Column="1" Margin="16,0"
                                                      Minimum="{Binding Value.SpanLow, FallbackValue=0}" Maximum="{Binding Value.SpanHigh, FallbackValue=1}"
                                                      Value="{Binding Value.Current.Physical, FallbackValue=0}"
                                                      Pending="{Binding Value.PendingValue, FallbackValue={x:Null}}"
                                                      TickLow="{Binding Value.TickLow, FallbackValue={x:Null}}" TickHigh="{Binding Value.TickHigh, FallbackValue={x:Null}}"
                                                      MinLabel="{Binding Value.SpanLowLabel, FallbackValue=''}" MaxLabel="{Binding Value.SpanHighLabel, FallbackValue=''}"
                                                      ToolTip.Tip="{Binding Value.SliderTip, FallbackValue=''}"
                                                      AutomationProperties.Name="{Binding SelectedItem.Title, FallbackValue=''}" />
                                <Button Name="StepUpButton" Grid.Column="2" Classes="icon" VerticalAlignment="Top" Click="StepUp_Click"
                                        ToolTip.Tip="{Binding Value.StepUpTip, FallbackValue=''}" AutomationProperties.Name="One step up">
                                    <controls:StrokeIcon Data="{StaticResource Icon.Plus}" />
                                </Button>
                            </Grid>
                            <!-- The legend of the XDF ticks, led by the tick it explains (system 5.14). -->
                            <DockPanel Name="LimitsLegendLine" Margin="0,12,0,0"
                                       IsVisible="{Binding Value.LimitsLegend, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                <Border DockPanel.Dock="Left" Width="2" Height="12" Margin="1,2,9,0" VerticalAlignment="Top" Background="{DynamicResource Ink2Brush}" />
                                <controls:NumberText Name="LimitsLegend" Value="{Binding Value.LimitsLegend, FallbackValue=''}" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>

                        <!-- A switch: its choices as a list you pick one from (system 5.13); picking writes at once. -->
                        <ListBox Name="ChoiceList" Width="360" HorizontalAlignment="Left"
                                 ItemsSource="{Binding Value.Choices, FallbackValue={x:Null}}" SelectedItem="{Binding Value.SelectedChoice, FallbackValue={x:Null}}"
                                 IsVisible="{Binding Value.IsSwitch, FallbackValue=False}" IsEnabled="{Binding !IsReadOnlyItem}"
                                 AutomationProperties.Name="{Binding SelectedItem.Title, FallbackValue=''}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ChoiceItem">
                                    <Grid ColumnDefinitions="16,*,Auto">
                                        <TextBlock Classes="data12 choice-raw" Text="{Binding Value}" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Margin="12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <controls:StrokeIcon Grid.Column="2" Data="{StaticResource Icon.Check}" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Ink1Brush}" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- A flag: the switch of system 5.5 with its state written beside it. -->
                        <ToggleSwitch Name="FlagSwitch" IsChecked="{Binding Value.IsOn, FallbackValue=False}" OnContent="On" OffContent="Off"
                                      IsVisible="{Binding Value.IsFlag, FallbackValue=False}" IsEnabled="{Binding !IsReadOnlyItem}"
                                      AutomationProperties.Name="{Binding SelectedItem.Title, FallbackValue=''}" />

                        <!-- The key line: what a drag will write, the last edit, and a refusal or warning above them. -->
                        <StackPanel Name="ValueKeyArea" Spacing="4" Margin="0,12,0,0">
                            <DockPanel IsVisible="{Binding Value.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                                <controls:StrokeIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Warn}" Foreground="{DynamicResource WarnBrush}" Width="14" Height="14"
                                                     Margin="0,1,8,0" VerticalAlignment="Top" />
                                <TextBlock Name="ValueMessage" Classes="body" Text="{Binding Value.Message, FallbackValue=''}" TextWrapping="Wrap" />
                            </DockPanel>
                            <WrapPanel Name="ValueKeyLine" ItemSpacing="24" LineSpacing="4">
                                <controls:NumberText Name="ValueDragText" Value="{Binding Value.DragText, FallbackValue=''}"
                                                     IsVisible="{Binding Value.DragText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                                <controls:NumberText Name="ValueKeyUndo" Value="{Binding UndoTip}" IsVisible="{Binding CanUndo}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bin open, nothing picked (system 7.1) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Spacing="8" IsVisible="{Binding NothingSelected}">
                        <TextBlock Classes="empty-title" Text="Pick a map, curve or value on the left" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Classes="body" Text="Search with Ctrl K. Pinned items stay at the top." TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink2Brush}" />
                    </StackPanel>

                    <!-- First run, and the first open (system 5.10, 7.1) -->
                    <Panel Name="EmptyBlock" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" IsVisible="{Binding !HasDocument}">
                        <StackPanel Spacing="8" IsVisible="{Binding !IsBusy}">
                            <TextBlock Name="EmptyTitle" Classes="empty-title" Text="Open a bin to start tuning" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Classes="body" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Ink2Brush}"
                                       Text="Choose the 512 KiB file you flash with MS4X Flasher. The XDF you last used for its firmware opens with it; otherwise you are asked for one." />
                            <TextBlock Name="XdfNeededText" Classes="body" Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource Ink1Brush}" IsVisible="{Binding NeedsXdf}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,16,0,0">
                                <Button Name="OpenBinButton" Classes.primary="{Binding !NeedsXdf}" Content="Open bin…" Click="OpenBin_Click" />
                                <Button Name="OpenXdfButton" Classes.primary="{Binding NeedsXdf}" Content="Open XDF…" Click="OpenXdf_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="12" Width="320" IsVisible="{Binding IsBusy}">
                            <ProgressBar Name="EmptyBusyBar" IsIndeterminate="True" Width="240" HorizontalAlignment="Center" />
                            <TextBlock Name="EmptyBusyText" Classes="body" Text="{Binding BusyText}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Panel>
                </Panel>
            </DockPanel>
        </Border>

        <!-- Inspector -->
    </Grid>
</UserControl>
