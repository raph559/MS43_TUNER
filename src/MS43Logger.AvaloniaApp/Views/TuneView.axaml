<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MS43Logger.AvaloniaApp"
             xmlns:controls="using:MS43Logger.AvaloniaApp.Controls"
             x:Class="MS43Logger.AvaloniaApp.Views.TuneView"
             x:DataType="local:TuneViewModel">
    <Panel>
        <!-- Nothing open yet -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440" IsVisible="{Binding !HasDocument}">
            <TextBlock Classes="display" FontSize="21" Text="Open a bin to start tuning" HorizontalAlignment="Center" />
            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Choose the 512 KiB file you flash with MS4X Flasher. The XDF you last used for its firmware opens with it; otherwise you are asked for one." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <Button Name="OpenBinButton" Classes="primary" Content="Open bin…" Click="OpenBin_Click" />
                <Button Name="OpenXdfButton" Content="Open XDF…" Click="OpenXdf_Click" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource UpBrush}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <Grid ColumnDefinitions="264,*,340" IsVisible="{Binding HasDocument}">
            <!-- Map rail -->
            <Border Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBox Name="SearchBox" Margin="14,14,14,6" Text="{Binding SearchText}" Watermark="Search maps and values   Ctrl K" />
                    <CheckBox Grid.Row="1" Margin="16,0,16,4" Content="Changed only" IsChecked="{Binding ModifiedOnly}" />
                    <ListBox Name="RailList" Grid.Row="2" ItemsSource="{Binding Rail}" SelectionChanged="Rail_SelectionChanged" Padding="0,4,0,18">
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="local:RailGroup">
                                <TextBlock Text="{Binding Title}" Classes="muted" FontSize="12" Margin="0,10,0,2" />
                            </DataTemplate>
                            <DataTemplate DataType="local:RailCategory">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink2Brush}" />
                                    <TextBlock Grid.Column="1" Classes="num muted" Text="{Binding Count}" />
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="local:RailItem">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{Binding IsIndented, Converter={x:Static local:Converters.Indent}}">
                                    <controls:ItemGlyph Kind="{Binding Kind}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Grid.Column="1" Classes="num" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               FontWeight="{Binding IsCurrent, Converter={x:Static local:Converters.Bold}}" />
                                    <Ellipse Grid.Column="2" Width="5" Height="5" Margin="6,0,0,0" Fill="{DynamicResource InkBrush}" IsVisible="{Binding IsModified}"
                                             ToolTip.Tip="Changed since the last save" />
                                    <TextBlock Grid.Column="3" Text="★" Margin="6,0,0,0" Foreground="{DynamicResource Ink2Brush}" IsVisible="{Binding IsPinned}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                </Grid>
            </Border>

            <!-- The selected item -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
                <StackPanel Margin="26,18,26,10" Spacing="6" IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="ItemTitle" Classes="display" FontSize="21" Text="{Binding SelectedItem.Title}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="ghost" Content="☆ Pin" Click="Pin_Click" VerticalAlignment="Center" ToolTip.Tip="Pin to the top of the rail" />
                    </Grid>
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                        <Border Classes="chip"><TextBlock Text="{Binding SelectedKindText}" /></Border>
                    </WrapPanel>
                    <TextBlock Classes="secondary" Text="{Binding SelectedItem.Description}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Name="EditError" Grid.Row="1" Margin="26,0,26,10" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource UpBrush}"
                           VerticalAlignment="Top" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Border Grid.Row="1" Margin="26,0,26,10" Padding="12,9" CornerRadius="6" BorderThickness="3,1,1,1"
                        BorderBrush="{DynamicResource UpBrush}" Background="{DynamicResource PaneBrush}"
                        IsVisible="{Binding FirmwareWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding FirmwareWarning}" TextWrapping="Wrap" />
                </Border>
                <Border Grid.Row="2" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="0,0,0,1" Padding="26,4,26,14"
                        IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                        <Border BorderBrush="{DynamicResource Bezel2Brush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource DialBrush}"
                                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Name="ToolValue" Width="90" BorderThickness="0" Background="Transparent" Classes="num" HorizontalContentAlignment="Right"
                                         Watermark="Value" Text="{Binding ToolValue}" KeyDown="ToolValue_KeyDown" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Editor.Units, FallbackValue=''}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Set" Tag="Set" Click="Tool_Click" ToolTip.Tip="Set the selected cells to the value" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button Content="Add" Tag="Add" Click="Tool_Click" ToolTip.Tip="Add the value to the selected cells" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button Content="Scale %" Tag="Scale" Click="Tool_Click" ToolTip.Tip="Change the selected cells by that many percent" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button Content="Interpolate" Tag="Interpolate" Click="Tool_Click" ToolTip.Tip="Fill between the corners of the selection" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Button Content="Smooth" Tag="Smooth" Click="Tool_Click" ToolTip.Tip="Average each cell with its neighbours" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border Width="1" Height="22" Background="{DynamicResource Bezel2Brush}" Margin="4,0" VerticalAlignment="Center" />
                        <Button Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}" />
                        <Button Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" />
                        <Button Classes="primary" Content="Save" Click="Save_Click" ToolTip.Tip="Save (Ctrl S). A .bak keeps the file as it was." />
                        <Button Name="SaveAsTool" Content="Save as…" Click="SaveAs_Click" ToolTip.Tip="Save to another file (Ctrl Shift S)" />
                        <Border Width="1" Height="22" Background="{DynamicResource Bezel2Brush}" Margin="4,0" VerticalAlignment="Center" />
                        <Button Name="OpenBinTool" Content="Open bin…" Click="OpenBin_Click" ToolTip.Tip="Open another bin (Ctrl O)" />
                        <Button Name="OpenXdfTool" Content="XDF…" Click="OpenXdf_Click" ToolTip.Tip="Use another XDF with this bin" />
                    </WrapPanel>
                </Border>
                <Grid Grid.Row="3" RowDefinitions="*,Auto" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="26,8,26,20">
                        <controls:MapGrid Name="MapGrid" Editor="{Binding Editor}" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="1240" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Margin="26,0,26,12" Text="{Binding Editor.Message}" TextWrapping="Wrap" Foreground="{DynamicResource Ink2Brush}"
                               IsVisible="{Binding Editor.Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Grid>
                <!-- Values, switches and flags -->
                <StackPanel Grid.Row="3" Margin="26,10,26,20" Spacing="14" IsVisible="{Binding Value, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Value.IsValue, FallbackValue=False}">
                        <TextBlock Classes="num" FontSize="48" Text="{Binding Value.Current.Display}" VerticalAlignment="Bottom" />
                        <TextBlock Classes="muted" FontSize="15" Text="{Binding Value.Units}" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Value.IsValue, FallbackValue=False}">
                        <TextBox Name="ValueInput" Width="140" Text="{Binding Value.Input}" Classes="num" KeyDown="ValueInput_KeyDown" />
                        <Button Classes="primary" Content="Set value" Click="SetValue_Click" />
                    </StackPanel>
                    <ComboBox Name="ChoiceBox" MinWidth="320" ItemsSource="{Binding Value.Choices}" SelectedItem="{Binding Value.SelectedChoice}"
                              IsVisible="{Binding Value.IsSwitch, FallbackValue=False}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ChoiceItem">
                                <TextBlock Text="{Binding Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ToggleSwitch Name="FlagSwitch" IsChecked="{Binding Value.IsOn}" OnContent="On" OffContent="Off"
                                  IsVisible="{Binding Value.IsFlag, FallbackValue=False}" />
                    <TextBlock Text="{Binding Value.Message}" Foreground="{DynamicResource Ink2Brush}" TextWrapping="Wrap"
                               IsVisible="{Binding Value.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                </StackPanel>

                <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Classes="display" FontSize="17" Text="Pick a map, curve or value on the left" HorizontalAlignment="Center" />
                    <TextBlock Classes="muted" Text="Search with Ctrl K. Pinned items stay at the top." HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Inspector -->
            <Border Name="InspectorHost" Grid.Column="2" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource BezelBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border BorderBrush="{DynamicResource BezelBrush}" BorderThickness="0,0,0,1" Padding="18,16" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding ShowsSurface, Converter={x:Static local:Converters.ShapeTitle}}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="drag to turn" IsVisible="{Binding ShowsSurface}" />
                                </Grid>
                                <controls:Surface3D Name="Surface" Height="250" Editor="{Binding Editor}" IsVisible="{Binding ShowsSurface}" />
                                <controls:CurveChart Name="Curve" Height="220" Editor="{Binding Editor}" IsVisible="{Binding ShowsCurve}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="18,16" IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Details" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:Fact">
                                            <Grid ColumnDefinitions="96,*" Margin="0,0,0,6">
                                                <TextBlock Classes="muted" Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1" Classes="num" Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="5" IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,6,0,0">
                                    <Border Height="8" CornerRadius="4" Background="{x:Static controls:HeatRamp.Brush}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <TextBlock Classes="num muted" FontSize="12" Text="{Binding LegendMin}" />
                                        <TextBlock Grid.Column="1" Classes="num muted" FontSize="12" Text="{Binding LegendMax}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Panel>
</UserControl>
