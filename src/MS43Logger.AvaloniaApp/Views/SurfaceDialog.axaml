<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MS43Logger.AvaloniaApp.Controls"
             xmlns:local="using:MS43Logger.AvaloniaApp"
             x:Class="MS43Logger.AvaloniaApp.Views.SurfaceDialog"
             x:DataType="local:TuneViewModel">
    <!-- The inspector's surface, large (Enlarge on the small plot): the same map, live cursor and view, with room to turn
         and zoom. Esc or Close goes back. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="Surface" />
                <TextBlock Name="MapTitle" Classes="mono13" Foreground="{DynamicResource Ink2Brush}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="toolgroup" VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Button Name="LargeZoomOutButton" Classes="icon" Click="ZoomOut_Click" ToolTip.Tip="Zoom out (Ctrl -)" AutomationProperties.Name="Zoom out">
                        <controls:StrokeIcon Data="{StaticResource Icon.Minus}" />
                    </Button>
                    <Button Name="LargeZoomInButton" Classes="icon" Click="ZoomIn_Click" ToolTip.Tip="Zoom in (Ctrl +)" AutomationProperties.Name="Zoom in">
                        <controls:StrokeIcon Data="{StaticResource Icon.Plus}" />
                    </Button>
                    <Button Name="LargeResetButton" Content="Reset view" Click="Reset_Click" ToolTip.Tip="Turn, zoom and position as at first (Home)" />
                </StackPanel>
            </Border>
            <!-- Undo and Redo for edits made here (Ctrl Z, Ctrl Y work too): the dialog stays open. -->
            <Border Grid.Column="1" Classes="toolgroup" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left" Name="SurfaceHistory">
                <StackPanel Orientation="Horizontal">
                    <Button Name="SurfaceUndoButton" Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoTip}" ToolTip.ShowOnDisabled="True" />
                    <Button Name="SurfaceRedoButton" Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoTip}" ToolTip.ShowOnDisabled="True" />
                </StackPanel>
            </Border>
            <Button Name="CloseSurfaceButton" Grid.Column="3" Classes="primary" Content="Close" Click="Close_Click" VerticalAlignment="Center" />
        </Grid>
        <!-- What is selected (where, and the values), or what a Ctrl-drag would do: how much, and where it ends. -->
        <controls:NumberText Name="SurfaceInfo" DockPanel.Dock="Bottom" Classes="body" Margin="0,12,0,0" Value="{Binding #LargeSurface.InfoText}"
                             IsVisible="{Binding #LargeSurface.InfoText, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Bottom" Classes="label" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Drag to turn, Shift-drag or right-drag to move, wheel or Ctrl + and Ctrl - to zoom. Click a point to select its cell (Shift-click a range), + or - to step the selection, Ctrl-drag to raise or lower it. Home resets the view." />
        <controls:Surface3D Name="LargeSurface" Margin="0,16,0,0" AutomationProperties.Name="Surface, large; the arrow keys turn it" />
    </DockPanel>
</UserControl>
