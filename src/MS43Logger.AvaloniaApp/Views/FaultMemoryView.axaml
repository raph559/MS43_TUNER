<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:MS43Logger.AvaloniaApp"
             x:Class="MS43Logger.AvaloniaApp.Views.FaultMemoryView"
             x:DataType="app:FaultMemoryViewModel"
             Width="520">
    <!-- "Fault memory" on the Live tab: the stored faults, read only. The P-code leads each row in the mono face the app uses
         for IDs, since it is what a reader looks up; the name and the details follow in the secondary ink. -->
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="title" Text="Fault memory" />
        <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="Read only: the app never clears the ECU's faults." />
        <TextBlock Name="SummaryText" DockPanel.Dock="Top" Classes="body" Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="{Binding Summary}" />
        <TextBlock Name="QueuesText" DockPanel.Dock="Top" Classes="label" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding Queues}" IsVisible="{Binding Queues, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,24,0,0">
            <Button Name="ReadAgainButton" Content="Read again" Click="ReadAgain_Click" IsEnabled="{Binding CanReadAgain}" />
            <Button Name="CloseButton" Classes="primary" Content="Close" Click="Close_Click" />
        </StackPanel>
        <ScrollViewer Margin="0,12,0,0" MaxHeight="320" IsVisible="{Binding HasFaults}">
            <ItemsControl Name="FaultList" ItemsSource="{Binding Faults}" AutomationProperties.Name="Stored faults">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:FaultRow">
                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                            <Grid ColumnDefinitions="72,*">
                                <TextBlock Classes="mono13" Text="{Binding PCode}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Classes="body" Text="{Binding Name}" />
                                    <TextBlock Classes="label" Text="{Binding Detail}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
