<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MS43Logger.AvaloniaApp.Views.ConfirmDialog"
        Title="Unsaved changes"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22" Spacing="16">
        <TextBlock Name="MessageText" Classes="display" FontSize="17" TextWrapping="Wrap" />
        <TextBlock Classes="secondary" TextWrapping="Wrap"
                   Text="Saving keeps a .bak of the file as it was and adds the changes to its edit log." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" />
            <Button Content="Don't save" Click="DontSave_Click" />
            <Button Classes="primary" Content="Save" Click="Save_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
